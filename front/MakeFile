APP_NAME := ufanet-front
IMAGE_NAME := ufanet-home-manager/front
IMAGE_TAG ?= local
CONTAINER_NAME := $(APP_NAME)
ROOT_DIR := ..
PORT ?= 3000

.PHONY: help install dev build up down restart logs clean

help:
	@echo "Targets:"
	@echo "  make install  Install npm dependencies"
	@echo "  make dev      Start local Vite dev server"
	@echo "  make build    Build Docker image"
	@echo "  make up       Start Docker container"
	@echo "  make down     Stop and remove Docker container"
	@echo "  make restart  Restart Docker container"
	@echo "  make logs     Follow Docker container logs"
	@echo "  make clean    Remove Docker image"

install:
	npm install

dev:
	npm run dev

build:
	docker build -f Dockerfile -t $(IMAGE_NAME):$(IMAGE_TAG) $(ROOT_DIR)

up: build
	docker rm -f $(CONTAINER_NAME) >/dev/null 2>&1 || true
	docker run -d \
		--name $(CONTAINER_NAME) \
		-p $(PORT):80 \
		$(IMAGE_NAME):$(IMAGE_TAG)

down:
	docker rm -f $(CONTAINER_NAME)

restart: down up

logs:
	docker logs -f $(CONTAINER_NAME)

clean:
	docker rmi -f $(IMAGE_NAME):$(IMAGE_TAG)

